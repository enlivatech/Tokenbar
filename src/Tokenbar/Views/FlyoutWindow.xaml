<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Tokenbar.Views.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Tokenbar">

    <Grid x:Name="Root" KeyDown="Root_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TabGrid" Grid.Row="0" Margin="8,8,8,6" ColumnSpacing="2" RowSpacing="2" />

        <Border Grid.Row="1" Height="1" Margin="16,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <ScrollViewer x:Name="ContentScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <StackPanel x:Name="ContentPanel" Padding="20,14,20,12" Spacing="14" />
        </ScrollViewer>

        <StackPanel Grid.Row="3" Padding="4,0,4,4">
            <Border Height="1" Margin="12,0,12,4" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Button x:Name="RefreshButton" Style="{StaticResource MenuRowButtonStyle}" Click="Refresh_Click">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    <TextBlock x:Name="RefreshText" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource MenuRowButtonStyle}" Click="Quit_Click">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE7E8;" FontSize="16" />
                    <TextBlock x:Name="QuitText" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
